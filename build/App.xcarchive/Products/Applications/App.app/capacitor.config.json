{
	"appId": "CaisterNetApp.socialapp",
	"appName": "CaisterPlayz",
	"webDir": "dist",
	"server": {
		"androidScheme": "http",
		"iosScheme": "http",
		"cleartext": true
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": true,
			"launchShowDuration": 2000,
			"backgroundColor": "#000000",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#000000"
		}
	},
	"ios": {
		"contentInset": "automatic",
		"preferredContentMode": "mobile",
		"scheme": "CaisterPlayz"
	},
	"packageClassList": []
}
